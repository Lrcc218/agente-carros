# Copie este arquivo para .env e preencha a chave do provedor escolhido.
# O .env nao vai para o repositorio.

# Provedor de IA em uso: gemini ou nvidia
PROVEDOR_LLM=gemini

# --- Google Gemini (padrao) ---
# Chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- NVIDIA NIM (alternativa) ---
# Chave gratuita em https://build.nvidia.com
# NVIDIA_API_KEY=

# Modelos. Se ficarem vazios, cada provedor usa o proprio padrao:
#   gemini -> gemini-2.0-flash e models/text-embedding-004
#   nvidia -> meta/llama-3.3-70b-instruct e nvidia/nv-embedqa-e5-v5
# MODELO_CHAT=
# MODELO_EMBEDDING=

# Comportamento do modelo
TEMPERATURA=0.1

# Quantidade de trechos recuperados por busca no RAG
TRECHOS_RECUPERADOS=4
