# Copie este arquivo para .env e preencha os valores.
# O .env nao vai para o repositorio.

# Chave da API do NVIDIA NIM (crie em https://build.nvidia.com)
NVIDIA_API_KEY=

# Provedor de LLM em uso: nvidia
PROVEDOR_LLM=nvidia

# Modelos utilizados
MODELO_CHAT=meta/llama-3.3-70b-instruct
MODELO_EMBEDDING=nvidia/nv-embedqa-e5-v5

# Comportamento do modelo
TEMPERATURA=0.1

# Quantidade de trechos recuperados por busca no RAG
TRECHOS_RECUPERADOS=4
