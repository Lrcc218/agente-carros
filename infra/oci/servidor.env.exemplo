# Ambiente do servico no servidor.
#
# O provisionar.sh copia este arquivo para /etc/agente-carros/ambiente com
# permissao 0640, dono root e grupo agente. O processo le, o usuario comum
# nao. Este exemplo vai para o repositorio; o arquivo real, nunca.
#
# Formato de EnvironmentFile do systemd: CHAVE=valor, sem `export`, sem aspas
# e sem espaco em volta do sinal de igual.

PROVEDOR_LLM=gemini

# Chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternativa: https://build.nvidia.com  (troque tambem PROVEDOR_LLM=nvidia)
# NVIDIA_API_KEY=

# Vazios usam o padrao de cada provedor, definido em src/agente_carros/config.py
# MODELO_CHAT=
# MODELO_EMBEDDING=

TEMPERATURA=0.1
TRECHOS_RECUPERADOS=4
LIMIAR_RELEVANCIA=0

# Registro de execucao. No servidor ele fica fora do diretorio da
# aplicacao, para sobreviver a um redeploy e ser rotacionado pelo sistema.
REGISTRAR_EXECUCOES=1
DIR_REGISTROS=/var/log/agente-carros
