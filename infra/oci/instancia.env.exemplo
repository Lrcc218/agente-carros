# Dados da instancia, usados por criar-instancia.sh e enviar.sh.
#
# Copie para infra/oci/instancia.env e preencha. O arquivo real esta no
# .gitignore: OCIDs identificam a sua tenancy e nao devem ir para um
# repositorio publico.
#
#   cp infra/oci/instancia.env.exemplo infra/oci/instancia.env

# --- acesso, usado por enviar.sh ---------------------------------------
# Ubuntu usa o login `ubuntu`; Oracle Linux usa `opc`.
HOST=ubuntu@0.0.0.0
CHAVE_SSH=~/.ssh/oci_agente_carros
RAMO=main

# --- criacao da instancia, usado por criar-instancia.sh ----------------
# Todos saem do console da OCI ou de `oci iam ...`.

# Identidade → Compartimentos (use o compartimento raiz da tenancy se nao
# tiver criado outro).
COMPARTMENT_OCID=

# Rede → Redes virtuais na nuvem → sua VCN → Sub-redes → sub-rede publica.
SUBNET_OCID=

# Domino de disponibilidade, ex.: kIdk:SA-SAOPAULO-1-AD-1
#   oci iam availability-domain list --compartment-id "$COMPARTMENT_OCID"
AVAILABILITY_DOMAIN=

# Imagem Ubuntu 24.04 para aarch64:
#   oci compute image list --compartment-id "$COMPARTMENT_OCID" \
#     --operating-system "Canonical Ubuntu" --shape VM.Standard.A1.Flex
IMAGE_OCID=

NOME_INSTANCIA=agente-carros
SHAPE=VM.Standard.A1.Flex
OCPUS=1
MEMORIA_GB=6
BOOT_GB=50
CHAVE_SSH_PUBLICA=~/.ssh/oci_agente_carros.pub

# Segundos entre tentativas quando a OCI responde "Out of host capacity".
# Capacidade ARM gratuita e disputada; a espera e normal.
INTERVALO_TENTATIVA=180
MAX_TENTATIVAS=0   # 0 = tentar indefinidamente
